# ---------------------------------------------------------------- secrets (critical)
# The API token lives in AWS Secrets Manager and is never written to the repo.
.env
.env.*
!.env.example
client/.streamlit/secrets.toml
!client/.streamlit/secrets.toml.example
*.pem
credentials

# ------------------------------------------------------------------------------ CDK
infra/cdk.out/
infra/node_modules/
# Compiled output of `tsc`. The recursive form matters: `infra/*.js` only matches the top
# level, so lib/ and bin/ leaked their build artifacts into the repository.
infra/**/*.js
infra/**/*.d.ts
infra/**/*.js.map
!infra/jest.config.js
cdk.context.json

# --------------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Vendored Lambda dependencies are built by scripts/build_lambda_deps.ps1, not committed.
services/ingest/vendor/

# ------------------------------------------------------------------------------- IDE
.idea/
.vscode/
*.swp

# ------------------------------------------------------------------------------- OS
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------- artifacts
*.log
out.json
kb-index.json.gz
