# Copy to secrets.toml and fill in, or run: python scripts/configure_client.py
#
# secrets.toml is gitignored. Only this example is version-controlled, so a real token
# cannot reach the repository by accident.

# From the stack output `ApiBaseUrl`. Includes the stage; no trailing slash.
API_BASE_URL = "https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev"

# From the stack output `GetTokenCommand`:
#   aws secretsmanager get-secret-value --secret-id <prefix>-<env>/api-token \
#     --query SecretString --output text
#
# This is the token the client presents to OUR API. It is not the model provider key --
# that one lives in Secrets Manager and is only ever read by the Lambdas.
API_TOKEN = "paste-the-48-character-token-here"
